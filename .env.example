# ==============================================================================
# KAVACH Wildlife Intelligence — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (local dev) or set these in your hosting provider's
# Environment Variables dashboard (Vercel, Render, Railway, etc.)
#
# IMPORTANT: Never commit .env or any file containing real secrets to Git.
# ==============================================================================

# ==============================================================================
# FRONTEND (Vite) — Variables must be prefixed with VITE_
# Set these in Vercel → Project Settings → Environment Variables
# ==============================================================================

# --------------------------------------------------------------------------
# Backend API URL
# --------------------------------------------------------------------------
# Local development (leave empty to auto-detect localhost:8000):
VITE_API_BASE_URL=http://localhost:8000
# Production example (your deployed Render/Railway backend):
# VITE_API_BASE_URL=https://kavach-api.onrender.com

# --------------------------------------------------------------------------
# Firebase Web Client Configuration
# --------------------------------------------------------------------------
# These are PUBLIC/CLIENT-SIDE keys — they identify your Firebase project.
# They are NOT secret. Restrict them in Firebase Console → App Check.
# Find them in: Firebase Console → Project Settings → General → Your Apps
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Web Push VAPID Key (public key)
# Find in: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key

# --------------------------------------------------------------------------
# Map Provider (optional)
# --------------------------------------------------------------------------
# Options: "esri" (default, free), "mapbox" (requires token), "google" (requires API key)
VITE_MAP_PROVIDER=esri

# Optional: Mapbox Satellite Token (leave blank to use free Esri World Imagery)
VITE_MAPBOX_ACCESS_TOKEN=

# Optional: Google Maps API Key (leave blank to use free Esri World Imagery)
VITE_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# BACKEND (FastAPI/Python) — Variables do NOT use VITE_ prefix
# Set these in Render/Railway → Environment Variables
# ==============================================================================

# --------------------------------------------------------------------------
# CORS — Required in production
# --------------------------------------------------------------------------
# Comma-separated list of your deployed frontend domain(s)
# Example: ALLOWED_ORIGINS=https://kavach-app.vercel.app,https://www.kavach.in
# Leave empty in local dev (allows all origins)
ALLOWED_ORIGINS=

# --------------------------------------------------------------------------
# Firebase Admin SDK (SERVER-SIDE ONLY — KEEP SECRET)
# --------------------------------------------------------------------------
# Option A: Path to service account JSON file (local dev)
FIREBASE_CREDENTIALS_PATH=backend/serviceAccountKey.json

# Option B: Inline JSON string (recommended for cloud hosting like Render)
# Paste the entire contents of your serviceAccountKey.json as a single-line JSON string.
# In Render: go to Environment → Add Secret File or set as environment variable.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Option C: Google Application Default Credentials (GCP/Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --------------------------------------------------------------------------
# YOLO Model Configuration
# --------------------------------------------------------------------------
# Path to the YOLO model weights file (relative to backend/ directory)
# The model is NOT committed to Git — upload it to your server/storage
MODEL_PATH=backend/best.pt
# Example: MODEL_PATH=backend/best_kavach_5class.pt

# --------------------------------------------------------------------------
# Server Configuration
# --------------------------------------------------------------------------
# Port (Render/Railway set this automatically — do not override in production)
PORT=8000
HOST=0.0.0.0

# Environment identifier
ENVIRONMENT=production

# --------------------------------------------------------------------------
# Optional: Notification Providers
# --------------------------------------------------------------------------
# Twilio SMS (optional — leave blank to skip SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP Email (optional — leave blank to skip email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@kavach.wildlife.gov.in

# IoT Siren Endpoint (optional — leave blank if no physical siren)
SIREN_IOT_ENDPOINT=

# --------------------------------------------------------------------------
# Optional: Detection Tuning
# --------------------------------------------------------------------------
# Confidence threshold (0.0 to 1.0) — default 0.35
WILDLIFE_CONFIDENCE_THRESHOLD=0.35

# IOU threshold for non-max suppression — default 0.45
IOU_THRESHOLD=0.45

# Device: "auto" (default), "cpu", or "cuda"
DEVICE=auto
